{
  "entities": {
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "High school student career exploration profile and academic preferences.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Student nickname or name.",
          "minLength": 1,
          "maxLength": 60
        },
        "grade": {
          "type": "string",
          "description": "Current high school grade level.",
          "enum": ["고1", "고2", "고3"],
          "minLength": 2,
          "maxLength": 10
        },
        "track": {
          "type": "string",
          "description": "Preferred academic track.",
          "enum": ["미정/통합", "인문·사회", "자연·공학", "예체능", "융합·IT"],
          "minLength": 2,
          "maxLength": 30
        },
        "hollandCode": {
          "type": "string",
          "description": "RIASEC career aptitude code.",
          "minLength": 1,
          "maxLength": 20
        },
        "favoriteSubjects": {
          "type": "string",
          "description": "Preferred school subjects summary.",
          "minLength": 1,
          "maxLength": 200
        },
        "targetMajors": {
          "type": "string",
          "description": "Interested university majors summary.",
          "minLength": 1,
          "maxLength": 200
        },
        "careerGoal": {
          "type": "string",
          "description": "Current career vision or aspiration.",
          "minLength": 1,
          "maxLength": 300
        },
        "strengths": {
          "type": "string",
          "description": "Student core strengths and interests.",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Profile creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last profile update server timestamp."
        }
      },
      "required": [
        "userId",
        "displayName",
        "grade",
        "track",
        "hollandCode",
        "favoriteSubjects",
        "targetMajors",
        "careerGoal",
        "strengths",
        "createdAt",
        "updatedAt"
      ]
    },
    "CounselingSession": {
      "title": "CounselingSession",
      "description": "A career counseling chat session thread belonging to a student.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Session topic title.",
          "minLength": 1,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "description": "Counseling theme category.",
          "enum": ["진로탐색", "학과선택", "고교학점제·과목선택", "학생부·세특설계", "학습·멘탈코칭"],
          "minLength": 2,
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "description": "Key takeaway or latest summary of the counseling session.",
          "minLength": 1,
          "maxLength": 500
        },
        "messageCount": {
          "type": "integer",
          "description": "Total messages exchanged in this session."
        },
        "status": {
          "type": "string",
          "description": "Session lifecycle status.",
          "enum": ["active", "archived"],
          "minLength": 6,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "sessionId",
        "ownerId",
        "title",
        "category",
        "summary",
        "messageCount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a counseling session subcollection.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique message identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Parent counseling session ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Message sender role.",
          "enum": ["user", "assistant"],
          "minLength": 4,
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "description": "Message body text.",
          "minLength": 1,
          "maxLength": 5000
        },
        "recommendedMajors": {
          "type": "string",
          "description": "Related university majors suggested in this turn.",
          "minLength": 0,
          "maxLength": 500
        },
        "actionItems": {
          "type": "string",
          "description": "Suggested student action items from this turn.",
          "minLength": 0,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Message creation server timestamp."
        }
      },
      "required": [
        "messageId",
        "sessionId",
        "ownerId",
        "role",
        "content",
        "recommendedMajors",
        "actionItems",
        "createdAt"
      ]
    },
    "CareerRoadmapItem": {
      "title": "CareerRoadmapItem",
      "description": "A milestone or activity in a student's high school career roadmap.",
      "type": "object",
      "properties": {
        "roadmapId": {
          "type": "string",
          "description": "Unique roadmap item ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gradeTarget": {
          "type": "string",
          "description": "Target high school semester.",
          "enum": ["고1 1학기", "고1 2학기", "고2 1학기", "고2 2학기", "고3 1학기", "고3 2학기"],
          "minLength": 4,
          "maxLength": 30
        },
        "category": {
          "type": "string",
          "description": "Roadmap activity category.",
          "enum": ["선택과목", "창체·동아리", "세특·탐구주제", "독서·프로젝트", "진로체험"],
          "minLength": 2,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "description": "Milestone title.",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Detailed plan and inquiry direction.",
          "minLength": 1,
          "maxLength": 1000
        },
        "relatedMajor": {
          "type": "string",
          "description": "Target university major connected to this milestone.",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "string",
          "description": "Execution status of the roadmap milestone.",
          "enum": ["planned", "in_progress", "completed"],
          "minLength": 7,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "roadmapId",
        "ownerId",
        "gradeTarget",
        "category",
        "title",
        "description",
        "relatedMajor",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/studentProfiles/{userId}": {
      "schema": "StudentProfile",
      "description": "Stores individual student career counseling profiles keyed by UID."
    },
    "/counselingSessions/{sessionId}": {
      "schema": "CounselingSession",
      "description": "Stores counseling session threads owned by authenticated students."
    },
    "/counselingSessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Stores individual chat messages within a specific counseling session."
    },
    "/careerRoadmaps/{roadmapId}": {
      "schema": "CareerRoadmapItem",
      "description": "Stores semester-by-semester career and academic roadmap milestones."
    }
  }
}
