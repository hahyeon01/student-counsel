rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // 3. Entity Validation Blueprints
    function isValidStudentProfile(data) {
      return data.keys().hasAll([
        'userId',
        'displayName',
        'grade',
        'track',
        'hollandCode',
        'favoriteSubjects',
        'targetMajors',
        'careerGoal',
        'strengths',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId',
        'displayName',
        'grade',
        'track',
        'hollandCode',
        'favoriteSubjects',
        'targetMajors',
        'careerGoal',
        'strengths',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.grade is string && data.grade.size() >= 2 && data.grade.size() <= 10 &&
      data.grade in ['고1', '고2', '고3'] &&
      data.track is string && data.track.size() >= 2 && data.track.size() <= 30 &&
      data.track in ['미정/통합', '인문·사회', '자연·공학', '예체능', '융합·IT'] &&
      data.hollandCode is string && data.hollandCode.size() >= 1 && data.hollandCode.size() <= 20 &&
      data.favoriteSubjects is string && data.favoriteSubjects.size() >= 1 && data.favoriteSubjects.size() <= 200 &&
      data.targetMajors is string && data.targetMajors.size() >= 1 && data.targetMajors.size() <= 200 &&
      data.careerGoal is string && data.careerGoal.size() >= 1 && data.careerGoal.size() <= 300 &&
      data.strengths is string && data.strengths.size() >= 1 && data.strengths.size() <= 300 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCounselingSession(data) {
      return data.keys().hasAll([
        'sessionId',
        'ownerId',
        'title',
        'category',
        'summary',
        'messageCount',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'sessionId',
        'ownerId',
        'title',
        'category',
        'summary',
        'messageCount',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.sessionId) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.category is string && data.category.size() >= 2 && data.category.size() <= 40 &&
      data.category in ['진로탐색', '학과선택', '고교학점제·과목선택', '학생부·세특설계', '학습·멘탈코칭'] &&
      data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 500 &&
      data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 1000 &&
      data.status is string && data.status.size() >= 6 && data.status.size() <= 20 &&
      data.status in ['active', 'archived'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll([
        'messageId',
        'sessionId',
        'ownerId',
        'role',
        'content',
        'recommendedMajors',
        'actionItems',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'messageId',
        'sessionId',
        'ownerId',
        'role',
        'content',
        'recommendedMajors',
        'actionItems',
        'createdAt'
      ]) &&
      isValidId(data.messageId) &&
      isValidId(data.sessionId) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      data.role is string && data.role.size() >= 4 && data.role.size() <= 20 &&
      data.role in ['user', 'assistant'] &&
      data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
      data.recommendedMajors is string && data.recommendedMajors.size() <= 500 &&
      data.actionItems is string && data.actionItems.size() <= 500 &&
      data.createdAt is timestamp;
    }

    function isValidCareerRoadmapItem(data) {
      return data.keys().hasAll([
        'roadmapId',
        'ownerId',
        'gradeTarget',
        'category',
        'title',
        'description',
        'relatedMajor',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'roadmapId',
        'ownerId',
        'gradeTarget',
        'category',
        'title',
        'description',
        'relatedMajor',
        'status',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.roadmapId) &&
      isValidId(data.ownerId) &&
      data.ownerId == request.auth.uid &&
      data.gradeTarget is string && data.gradeTarget.size() >= 4 && data.gradeTarget.size() <= 30 &&
      data.gradeTarget in ['고1 1학기', '고1 2학기', '고2 1학기', '고2 2학기', '고3 1학기', '고3 2학기'] &&
      data.category is string && data.category.size() >= 2 && data.category.size() <= 40 &&
      data.category in ['선택과목', '창체·동아리', '세특·탐구주제', '독서·프로젝트', '진로체험'] &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
      data.relatedMajor is string && data.relatedMajor.size() >= 1 && data.relatedMajor.size() <= 100 &&
      data.status is string && data.status.size() >= 7 && data.status.size() <= 20 &&
      data.status in ['planned', 'in_progress', 'completed'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    // Student Profiles
    match /studentProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow list: if false;

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidStudentProfile(incoming()) &&
        incoming().userId == userId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidStudentProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action: Update Profile Details
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'grade',
            'track',
            'hollandCode',
            'favoriteSubjects',
            'targetMajors',
            'careerGoal',
            'strengths',
            'updatedAt'
          ])
        )
      );

      allow delete: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
    }

    // Counseling Sessions
    match /counselingSessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(sessionId) &&
        isValidCounselingSession(incoming()) &&
        incoming().sessionId == sessionId &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn() &&
        isValidId(sessionId) &&
        isValidCounselingSession(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().sessionId == existing().sessionId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status != 'archived' && (
          // Action 1: Progress Session (Update summary, messageCount, title)
          (
            incoming().status == 'active' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'summary', 'messageCount', 'updatedAt'])
          ) ||
          // Action 2: Archive Session (Terminal State Transition)
          (
            incoming().status == 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        )
      );

      allow delete: if isSignedIn() && isValidId(sessionId) && existing().ownerId == request.auth.uid;

      // Subcollection: Chat Messages (Master Gate Enforced)
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(messageId) &&
          existing().ownerId == request.auth.uid &&
          exists(/databases/$(database)/documents/counselingSessions/$(sessionId)) &&
          get(/databases/$(database)/documents/counselingSessions/$(sessionId)).data.ownerId == request.auth.uid;

        allow list: if isSignedIn() &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(messageId) &&
          isValidChatMessage(incoming()) &&
          incoming().messageId == messageId &&
          incoming().sessionId == sessionId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/counselingSessions/$(sessionId)) &&
          get(/databases/$(database)/documents/counselingSessions/$(sessionId)).data.ownerId == request.auth.uid &&
          get(/databases/$(database)/documents/counselingSessions/$(sessionId)).data.status != 'archived';

        allow update: if false;

        allow delete: if isSignedIn() &&
          isValidId(sessionId) &&
          isValidId(messageId) &&
          existing().ownerId == request.auth.uid &&
          exists(/databases/$(database)/documents/counselingSessions/$(sessionId)) &&
          get(/databases/$(database)/documents/counselingSessions/$(sessionId)).data.ownerId == request.auth.uid;
      }
    }

    // Career Roadmaps
    match /careerRoadmaps/{roadmapId} {
      allow get: if isSignedIn() && isValidId(roadmapId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn() &&
        isValidId(roadmapId) &&
        isValidCareerRoadmapItem(incoming()) &&
        incoming().roadmapId == roadmapId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if (
        isSignedIn() &&
        isValidId(roadmapId) &&
        isValidCareerRoadmapItem(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().roadmapId == existing().roadmapId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        existing().status != 'completed' && (
          // Action 1: Edit Roadmap Item Content
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'gradeTarget',
              'category',
              'title',
              'description',
              'relatedMajor',
              'status',
              'updatedAt'
            ])
          ) ||
          // Action 2: Transition Status Only
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        )
      );

      allow delete: if isSignedIn() && isValidId(roadmapId) && existing().ownerId == request.auth.uid;
    }
  }
}
